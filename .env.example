# Copy to .env and fill in. Never commit .env.

# LLM (Google AI Studio, free tier)
GEMINI_API_KEY=

# EventPulse test attendee (a separate ATTENDEE account, not your organizer account)
VERDICT_TEST_EMAIL=
VERDICT_TEST_PASSWORD=

# Where EventPulse's frontend is running
PREVIEW_URL=http://localhost:3000

# Reset test data before every check (cancels the test user's bookings in EventPulse)
VERDICT_RESET=eventpulse
VERDICT_RESET_API_URL=http://localhost:5001/api

# HTTP API (pnpm api)
VERDICT_API_KEY=
# PORT=8787

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low
# VERDICT_LOG_LEVEL=info
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chromium
